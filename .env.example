# --- FAL -------------------------------------------------------------------
# Your FAL API key (https://fal.ai/dashboard/keys). Replace the placeholder;
# while it stays as is, generation is disabled with a clear error.
# On FAL Serverless set it as a secret instead:  fal secrets set FAL_KEY=...
FAL_KEY=__SET_YOUR_FAL_KEY__

# Optional: only for createWaveSpeedBackgroundRemover()
WAVESPEED_API_KEY=__SET_YOUR_WAVESPEED_KEY__

# --- Storage ---------------------------------------------------------------
# File storage root. On FAL Serverless keep it under the persistent /data volume.
STORYBOOK_DATA_DIR=./story-data
# Optional Postgres for records (recommended with many users / runners).
# DATABASE_URL=postgres://user:pass@host:5432/db

# --- Server ----------------------------------------------------------------
PORT=8080
# Shared secret clients send as the x-storybook-token header. Empty = no check.
STORYBOOK_API_TOKEN=__SET_YOUR_API_TOKEN__
# Public URL of this server (e.g. https://fal.run/<user>/<app>); needed for webhooks.
# STORYBOOK_PUBLIC_URL=
# STORYBOOK_WEBHOOKS=1
STORYBOOK_POLL_INTERVAL_MS=5000

# --- Limits (empty = unlimited) --------------------------------------------
# STORYBOOK_MAX_RENDERS_PER_DAY=200
# STORYBOOK_MAX_CONCURRENT_RENDERS=8
# STORYBOOK_MAX_DAILY_COST_USD=20
