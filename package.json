{
  "name": "imgen-storybook",
  "type": "module",
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@graphql-tools/schema": "^10.1.4",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.5",
    "pg": "^8.23.1",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "schema": "tsx scripts/print-schema.ts",
    "prepare": "npm run build",
    "dev": "tsx --env-file-if-exists=.env examples/server.ts",
    "start": "node dist/server/main.js"
  },
  "description": "Illustrated-story image engine (TS library + GraphQL mutations) built on FAL",
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./graphql": {
      "types": "./dist/graphql/index.d.ts",
      "import": "./dist/graphql/index.js"
    },
    "./schema.graphql": "./schema.graphql"
  },
  "files": [
    "dist",
    "schema.graphql"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/researchanddeploy/imgen-storybook.git"
  },
  "homepage": "https://github.com/researchanddeploy/imgen-storybook#readme",
  "keywords": [
    "illustrated-stories",
    "image-generation",
    "graphql",
    "fal",
    "storybook"
  ]
}
